{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.ts",
	"name": "live-echo-app",
	"compatibility_date": "2026-08-11",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// workers.dev の URL は pineville.dev ゾーンの WAF（マネージドルール・
	// レート制限）を通らない。実際に WAF が RCE 狙いの POST を日常的に
	// ブロックしているため、WAF を迂回できる入口は閉じておく。
	// フォールバック URL が必要になったら一時的に true へ戻す。
	"workers_dev": false,
	// カスタムドメイン。Cloudflare Registrar で購入済みのゾーンなので DNS/SSL は
	// deploy 時に自動でプロビジョニングされる。
	// apex（pineville.dev）には何も置かない。ドメインを知っていれば最初に
	// 叩かれる入口なので、アプリはサブドメインだけで公開する。
	"routes": [
		{
			"pattern": "live.pineville.dev",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "live-echo-app"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SESSION_DO",
				"class_name": "SessionDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			// SQLite バックエンド: Free プランでも使える（KV バックエンドは Paid 限定）
			"new_sqlite_classes": ["SessionDO"]
		}
	]
}
